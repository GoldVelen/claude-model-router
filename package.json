{
  "name": "claude-model-router",
  "version": "0.3.0",
  "description": "Zero-dependency Anthropic-format API proxy for Claude Code. Multi-backend routing, hot reload, config validation, and detailed logging.",
  "keywords": [
    "claude-code",
    "anthropic",
    "api-router",
    "deepseek",
    "llm-proxy"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "cmr": "./bin/cmr.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "bin",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test --import tsx tests/*.test.ts tests/**/*.test.ts",
    "start": "tsx src/server.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "changelog": "tsx scripts/generate-changelog.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
